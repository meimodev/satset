rules_version = '2';

// SatSet fleet model. See:
//   docs/adr/0015-firebase-admin-auth-and-server-kill-switch.md (auth + kill switch)
//   docs/adr/0016-fleet-superadmin-cloud-control-plane.md (super admin + venues)
//   docs/adr/0036-owner-cloud-report-snapshot.md (owner + report snapshot)
//
// Privileged mutations (create/disable/delete admins, create/edit venues, flip
// the kill switch, set billing) go through Cloud Functions (Admin SDK), which
// BYPASS these rules. The client only ever: reads its own docs, the super admin
// reads everything, a normal admin writes ONLY its own venue's heartbeat +
// report snapshot, and an owner reads ONLY its venue's report + requests a
// refresh.
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the requester's own admin doc is flagged as the fleet operator.
    // Costs one get() per evaluation — accepted for a low-traffic console.
    function isSuper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super';
    }

    function signedIn() {
      return request.auth != null;
    }

    // The requester's own admin doc (identity + role + venueId).
    function me() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // True when the requester is the host admin of venue `vid` (writes the
    // heartbeat + report snapshot, both pinned to its own venue).
    function isVenueAdmin(vid) {
      return signedIn() && me().venueId == vid && me().role == 'admin';
    }

    // True when the requester is the read-only report owner of venue `vid`.
    function isOwner(vid) {
      return signedIn() && me().venueId == vid && me().role == 'owner';
    }

    // Only the named fields changed between before/after.
    function onlyFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    match /admins/{uid} {
      // An admin reads its own doc (identity + eligibility + venueId); the super
      // admin reads every admin doc for the fleet console.
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      // No client writes. role/status/venueId are set only via Cloud Functions.
      allow write: if false;
    }

    match /venues/{vid} {
      // The super admin reads all venues; a normal admin reads only the venue it
      // belongs to (its own kill switch + billing state).
      allow read: if isSuper()
        || (signedIn()
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.venueId == vid);

      // Heartbeat ONLY: a normal admin bound to this venue may touch lastSeenAt
      // and nothing else. The kill switch (status), billing, etc. stay
      // function-only so this write path can never reopen a suspended venue.
      allow update: if signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.venueId == vid
        && onlyFields(['lastSeenAt']);

      // create/delete/status/billing → Cloud Functions only.
      allow create, delete: if false;
    }

    // Published report snapshot (ADR-0036): the host writes its own venue's
    // snapshot; the owner (and the host) reads it. Kept off venues/{vid} so
    // fleet-console venue reads don't drag the payload.
    match /reports/{vid} {
      allow read: if isVenueAdmin(vid) || isOwner(vid);
      // Only the host admin of this venue may publish, and only to its own
      // venue's doc — same containment as the heartbeat.
      allow write: if isVenueAdmin(vid);
    }

    // Owner's manual-refresh command (ADR-0036): the owner stamps requestedAt;
    // the host listens and republishes. Owner writes ONLY requestedAt; the host
    // reads the request to fulfil it.
    match /report_requests/{vid} {
      allow read: if isVenueAdmin(vid) || isOwner(vid);
      // First refresh creates the doc (resource.data is null → onlyFields would
      // error), later refreshes update it. Both: owner-only, requestedAt-only.
      allow create: if isOwner(vid)
        && request.resource.data.keys().hasOnly(['requestedAt']);
      allow update: if isOwner(vid) && onlyFields(['requestedAt']);
      allow delete: if false;
    }

    // Fleet-wide configuration that belongs to no venue and no admin. Today
    // that is `config/release_gate` (ADR-0087): the min/recommended/latest
    // versions the fleet may run. Every signed-in admin reads it — a host that
    // could not read the gate would fail open and never update — and no client
    // writes it. Codemagic writes it with a service account (which bypasses
    // these rules); the super admin's console override goes through the
    // setReleaseGate callable, for the same reason every other privileged
    // mutation does.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Fleet audit trail: who did what to which venue/admin, written by the
    // Cloud Functions (Admin SDK, bypasses these rules) and by nothing else.
    // Read is super-only — a venue admin has no business reading the fleet's
    // history, and the records name other venues. Write is denied outright
    // rather than scoped: a log the subject of the log can edit is not a log,
    // and there is no client that legitimately appends to this.
    match /fleet_audit/{entry} {
      allow read: if isSuper();
      allow write: if false;
    }

    // Everything else denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
